# Niglas configuration. Copy to .env and adjust; never commit a filled-in .env.
# Every variable is prefixed NIGLAS_ and read by apps/api/src/niglas_api/settings.py.

# --- Core ---
NIGLAS_ENVIRONMENT=local
NIGLAS_DATABASE_URL=postgresql+asyncpg://niglas:niglas@localhost:5432/niglas

# --- Authentication (development stub; see docs/SECURITY.md) ---
# HS256 signing key for locally issued operator tokens. Replace in any shared
# environment: anyone holding this key can mint a token for any role.
NIGLAS_JWT_SECRET=change-me-local-development-only
NIGLAS_JWT_ISSUER=niglas-local
NIGLAS_TOKEN_TTL_MINUTES=60

# --- Ingestion limits ---
NIGLAS_MAX_EVENTS_PER_BATCH=500

# --- Tests ---
# Integration tests that need a real database read this and are skipped without it.
NIGLAS_TEST_DATABASE_URL=postgresql+asyncpg://niglas:niglas@localhost:5432/niglas_test
